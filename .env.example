APP_VERSION=latest

POSTGRES_ROOT_USER=postgres
POSTGRES_ROOT_PASSWORD=root_password
SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:postgresql://db-sudolife:5432/sudolife_db
DB_NAME=sudolife_db
DB_USER=sudolife_app
DB_PASSWORD=db_secret_password

API_SECURITY_TOKEN_SECRET=
API_SECURITY_TOKEN_ISSUER=sudolife-api
API_SECURITY_TOKEN_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=https://app.sudolife.example,https://admin.sudolife.example
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=PT1H

PASSWORD_RECOVERY_MAIL_DELIVERY=resend
FRONTEND_BASE_URL=https://app.sudolife.example
RESEND_API_URL=https://api.resend.com
RESEND_API_KEY=
PASSWORD_RECOVERY_MAIL_SENDER=Sudolife <security@sudolife.example>
RESEND_CONNECT_TIMEOUT=2s
RESEND_READ_TIMEOUT=5s

LOGIN_IP_RATE_LIMIT_ENABLED=true
LOGIN_IP_RATE_LIMIT_CAPACITY=10
LOGIN_IP_RATE_LIMIT_REFILL_PERIOD=PT1M
LOGIN_EMAIL_RATE_LIMIT_ENABLED=true
LOGIN_EMAIL_RATE_LIMIT_CAPACITY=5
LOGIN_EMAIL_RATE_LIMIT_REFILL_PERIOD=PT15M
LOGIN_EMAIL_ORIGIN_RATE_LIMIT_ENABLED=true
LOGIN_EMAIL_ORIGIN_RATE_LIMIT_CAPACITY=5
LOGIN_EMAIL_ORIGIN_RATE_LIMIT_REFILL_PERIOD=PT15M

REGISTRATION_ORIGIN_RATE_LIMIT_ENABLED=true
REGISTRATION_ORIGIN_RATE_LIMIT_CAPACITY=5
REGISTRATION_ORIGIN_RATE_LIMIT_REFILL_PERIOD=PT1H
REGISTRATION_EMAIL_RATE_LIMIT_ENABLED=true
REGISTRATION_EMAIL_RATE_LIMIT_CAPACITY=3
REGISTRATION_EMAIL_RATE_LIMIT_REFILL_PERIOD=PT1H

PASSWORD_RECOVERY_START_ORIGIN_RATE_LIMIT_ENABLED=true
PASSWORD_RECOVERY_START_ORIGIN_RATE_LIMIT_CAPACITY=5
PASSWORD_RECOVERY_START_ORIGIN_RATE_LIMIT_REFILL_PERIOD=PT1H
PASSWORD_RECOVERY_START_EMAIL_RATE_LIMIT_ENABLED=true
PASSWORD_RECOVERY_START_EMAIL_RATE_LIMIT_CAPACITY=3
PASSWORD_RECOVERY_START_EMAIL_RATE_LIMIT_REFILL_PERIOD=PT1H
PASSWORD_RECOVERY_COMPLETE_ORIGIN_RATE_LIMIT_ENABLED=true
PASSWORD_RECOVERY_COMPLETE_ORIGIN_RATE_LIMIT_CAPACITY=10
PASSWORD_RECOVERY_COMPLETE_ORIGIN_RATE_LIMIT_REFILL_PERIOD=PT15M

GENERIC_API_RATE_LIMIT_ENABLED=true
GENERIC_API_RATE_LIMIT_CAPACITY=120
GENERIC_API_RATE_LIMIT_REFILL_PERIOD=PT1M

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=client_secret_strava
STRAVA_AUTHORIZATION_URL=https://www.strava.com/oauth/authorize
STRAVA_TOKEN_URL=https://www.strava.com/api/v3/oauth/token
STRAVA_DEAUTHORIZATION_URL=https://www.strava.com/oauth/deauthorize
STRAVA_ACTIVITIES_URL=https://www.strava.com/api/v3/athlete/activities
STRAVA_ACTIVITY_DETAIL_URL=https://www.strava.com/api/v3/activities/{activityId}
STRAVA_ACTIVITY_STREAMS_URL=https://www.strava.com/api/v3/activities/{activityId}/streams
STRAVA_ATHLETE_ZONES_URL=https://www.strava.com/api/v3/athlete/zones
STRAVA_REDIRECT_URI=https://api.sudolife.example/api/strava/callback
STRAVA_FRONTEND_SUCCESS_REDIRECT_URL=https://app.sudolife.example/settings/connections/strava/success
STRAVA_FRONTEND_FAILURE_REDIRECT_URL=https://app.sudolife.example/settings/connections/strava/failure

AI_RUNNING_PLAN_PROVIDER_URL=http://ollama-sudolife:11434
AI_RUNNING_PLAN_PROVIDER_MODEL=llama3:8b
AI_RUNNING_PLAN_PROVIDER_CONNECT_TIMEOUT=5s
AI_RUNNING_PLAN_PROVIDER_READ_TIMEOUT=120s

DOCKER_USER=secret_user
DOCKER_PWD=secret_pwd
